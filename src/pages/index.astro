---
import { Client } from "@notionhq/client";

const notion = new Client({ auth: import.meta.env.NOTION_API_KEY });

let booksWithContent = [];
let errorMessage = "";

try {
  const response = await notion.databases.query({
    database_id: import.meta.env.NOTION_DATABASE_ID,
    filter: {
      property: "Reviewed",
      checkbox: { equals: true }
    },
    sorts: [{ property: "Date Finished", direction: "descending" }]
  });

  booksWithContent = await Promise.all(
    response.results.map(async (book) => {
      const blocksResponse = await notion.blocks.children.list({ block_id: book.id });
      return {
        ...book,
        contentBlocks: blocksResponse.results,
      };
    })
  );
} catch (error) {
  errorMessage = error.message;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Cherie Reads</title>
    <script defer src="/_vercel/insights/script.js"></script>
    <style>
      :root {
        --card-bg: #fcfbf9;
        --border-color: #c4d6c7;
        --text-color: #2c352d;
        --text-muted: #556358;
        --accent: #2e5a36;
        --accent-hover: #1e3d24;
        --lavender-accent: #7b6d8d;
        --lavender-bg: #f4f2f6;
        --serif-font: "Georgia", "Times New Roman", serif;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
        /* Rich, dimensional sage gradient background */
        background: linear-gradient(135deg, #d8e4da 0%, #eef3ef 50%, #d2e0d4 100%);
        color: var(--text-color);
        line-height: 1.6;
        min-height: 100vh;
      }
      header {
        background: rgba(252, 251, 249, 0.9);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border-color);
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 1px 3px rgba(46, 90, 54, 0.04);
      }
      header h1 {
        margin: 0;
        font-family: var(--serif-font);
        font-size: 2rem;
        color: var(--accent);
        letter-spacing: -0.5px;
        font-weight: normal;
        font-style: italic;
      }
      nav a {
        color: var(--text-muted);
        text-decoration: none;
        margin-left: 20px;
        font-weight: 500;
        font-size: 0.95rem;
        transition: color 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      .layout {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 40px;
      }
      aside {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        height: fit-content;
        box-shadow: 0 4px 12px rgba(46, 90, 54, 0.04);
      }
      aside h3 {
        margin-top: 0;
        font-family: var(--serif-font);
        font-size: 1.2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        color: var(--accent);
      }
      .filter-group {
        margin-bottom: 16px;
      }
      .filter-group label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 6px;
      }
      .filter-select {
        width: 100%;
        padding: 8px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        background: #ffffff;
        color: var(--text-color);
        font-size: 0.9rem;
      }
      .feed {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      /* Welcoming Hero Banner */
      .welcome-banner {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 28px 32px;
        box-shadow: 0 4px 12px rgba(46, 90, 54, 0.04);
        margin-bottom: 4px;
      }
      .welcome-banner h2 {
        margin-top: 0;
        font-family: var(--serif-font);
        color: var(--accent);
        font-size: 1.6rem;
        font-weight: normal;
        margin-bottom: 10px;
      }
      .welcome-banner p {
        margin: 0;
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1.6;
      }
      .book-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 24px;
        box-shadow: 0 4px 12px rgba(46, 90, 54, 0.04);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        display: flex;
        gap: 20px;
      }
      .book-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(46, 90, 54, 0.1);
        border-color: var(--accent);
      }
      .book-card.hidden {
        display: none;
      }
      .cover-container {
        flex-shrink: 0;
        width: 90px;
        height: 135px;
        background: #e3ece4;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--border-color);
      }
      .cover-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }
      .book-card:hover .cover-container img {
        transform: scale(1.03);
      }
      .book-info {
        flex-grow: 1;
      }
      .book-card h2 {
        margin-top: 0;
        margin-bottom: 6px;
        font-family: var(--serif-font);
        font-size: 1.5rem;
        color: #1a241c;
      }
      .meta {
        font-size: 0.95rem;
        color: var(--text-muted);
        margin-bottom: 10px;
        font-weight: 500;
      }
      .vibe-teaser {
        font-family: var(--serif-font);
        font-style: italic;
        color: var(--lavender-accent);
        background: var(--lavender-bg);
        padding: 6px 12px;
        border-radius: 4px;
        margin-bottom: 15px;
        font-size: 0.95rem;
        display: inline-block;
        border-left: 3px solid var(--lavender-accent);
      }
      details {
        border-top: 1px solid var(--border-color);
        padding-top: 12px;
      }
      summary {
        cursor: pointer;
        font-weight: 600;
        color: var(--accent);
        font-size: 0.95rem;
        user-select: none;
      }
      summary:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }
      .review-body {
        margin-top: 15px;
      }
      .review-body p {
        margin-bottom: 1em;
      }
      .error {
        background: #fde8e8;
        color: #9b1c1c;
        padding: 15px;
        border-radius: 6px;
      }
      @media (max-width: 768px) {
        .layout {
          grid-template-columns: 1fr;
        }
        .book-card {
          flex-direction: column;
        }
        .cover-container {
          width: 100px;
          height: 150px;
          margin-bottom: 10px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Cherie Reads</h1>
      <nav>
        <a href="/">Home</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <div class="layout">
      <!-- Sidebar Dropdown Filters -->
      <aside>
        <h3>Filter Reviews</h3>
        
        <div class="filter-group">
          <label for="rating-filter">Star Rating</label>
          <select id="rating-filter" class="filter-select">
            <option value="all">All Ratings</option>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="genre-filter">Genre</label>
          <select id="genre-filter" class="filter-select">
            <option value="all">All Genres</option>
            <option value="Fantasy">Fantasy</option>
            <option value="Sci-Fi">Sci-Fi</option>
            <option value="Romance">Romance</option>
            <option value="Historical">Historical</option>
            <option value="Mystery">Mystery</option>
          </select>
        </div>
      </aside>

      <!-- Main Review Feed -->
      <main class="feed">
        <!-- Welcoming Hero Banner -->
        <div class="welcome-banner">
          <h2>Welcome to My Reading Sanctuary</h2>
          <p>A quiet corner of the internet dedicated to sweeping fantasy, rich historical fiction, and stories that leave a lasting emotional mark. Grab a cup of tea and browse my digital bookshelf.</p>
        </div>

        {errorMessage && <div class="error"><p><strong>Error:</strong> {errorMessage}</p></div>}
        
        {booksWithContent.length === 0 && !errorMessage && (
          <p>No reviewed books found yet. Check the "Reviewed" box on a book page in your Notion library to publish it here!</p>
        )}

        {booksWithContent.map((book) => {
          const title = book.properties["Title"]?.title?.[0]?.plain_text || "Untitled";
          
          const authorArray = book.properties["Author name for Blog"]?.rollup?.array;
          let author = "Unknown Author";
          if (authorArray && authorArray.length > 0) {
            const names = authorArray.map((item) => item.title?.[0]?.plain_text).filter(Boolean);
            if (names.length > 0) author = names.join(", ");
          }

          const ratingProp = book.properties["Rating Number"] || book.properties["Star Rating"];
          let rating = "";
          if (ratingProp?.type === "number") rating = ratingProp.number.toString();
          else if (ratingProp?.type === "select") rating = ratingProp.select?.name || "";
          else if (ratingProp?.type === "formula") rating = ratingProp.formula.string || ratingProp.formula.number?.toString() || "";

          const vibeProp = book.properties["Vibe"] || book.properties["Genre"];
          let vibe = "";
          if (vibeProp?.type === "select") vibe = vibeProp.select?.name || "";
          else if (vibeProp?.type === "multi_select") vibe = vibeProp.multi_select?.map(v => v.name).join(', ') || "";
          else if (vibeProp?.type === "rich_text") vibe = vibeProp.rich_text?.[0]?.plain_text || "";

          const mediaProp = book.properties["Cover"] || book.properties["Files & media"] || book.properties["Image"];
          let coverUrl = "";
          if (mediaProp?.type === "files" && mediaProp.files.length > 0) {
            const fileItem = mediaProp.files[0];
            coverUrl = fileItem.file?.url || fileItem.external?.url || "";
          }
          
          return (
            <div class="book-card" data-rating={rating} data-genre={vibe}>
              {coverUrl && (
                <div class="cover-container">
                  <img src={coverUrl} alt={`Cover of ${title}`} loading="lazy" />
                </div>
              )}
              <div class="book-info">
                <h2>{title}</h2>
                <div class="meta">
                  <span><strong>Author:</strong> {author}</span>
                  {rating && <span style="margin-left: 15px;"><strong>Rating:</strong> {rating}</span>}
                </div>

                {vibe && <div class="vibe-teaser">{vibe}</div>}
                
                <details>
                  <summary>Read Review</summary>
                  <div class="review-body">
                    {book.contentBlocks.map((block) => (
                      block.type === "paragraph" && block.paragraph.rich_text.length > 0 
                        ? <p>{block.paragraph.rich_text.map((t) => t.plain_text).join("")}</p>
                        : null
                    ))}
                  </div>
                </details>
              </div>
            </div>
          );
        })}
      </main>
    </div>

    <script>
      const ratingSelect = document.getElementById('rating-filter');
      const genreSelect = document.getElementById('genre-filter');
      const cards = document.querySelectorAll('.book-card');

      function filterCards() {
        const ratingVal = ratingSelect.value;
        const genreVal = genreSelect.value.toLowerCase();

        cards.forEach(card => {
          const cardRating = card.getAttribute('data-rating') || '';
          const cardGenre = (card.getAttribute('data-genre') || '').toLowerCase();

          const matchesRating = (ratingVal === 'all' || cardRating.includes(ratingVal));
          const matchesGenre = (genreVal === 'all' || cardGenre.includes(genreVal));

          if (matchesRating && matchesGenre) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      ratingSelect.addEventListener('change', filterCards);
      genreSelect.addEventListener('change', filterCards);
    </script>
  </body>
</html>
