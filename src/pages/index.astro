---
import { Client } from "@notionhq/client";

const notion = new Client({ auth: import.meta.env.NOTION_API_KEY });

let booksWithContent = [];
let errorMessage = "";

try {
  const response = await notion.databases.query({
    database_id: import.meta.env.NOTION_DATABASE_ID,
    filter: {
      property: "Reviewed",
      checkbox: { equals: true }
    },
    sorts: [{ property: "Date Finished", direction: "descending" }]
  });

  booksWithContent = await Promise.all(
    response.results.map(async (book) => {
      return book;
    })
  );
} catch (error) {
  errorMessage = error.message;
}

function renderStars(ratingStr) {
  const num = parseFloat(ratingStr);
  if (isNaN(num)) return ratingStr;
  
  const fullStars = Math.floor(num);
  const hasHalfStar = num - fullStars >= 0.5;
  const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
  
  let stars = "★".repeat(fullStars);
  if (hasHalfStar) stars += "⯨";
  stars += "☆".repeat(emptyStars);
  
  return `${stars} ${num.toFixed(num % 1 !== 0 ? 1 : 0)}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Cherie Reads</title>
    <script defer src="/_vercel/insights/script.js"></script>
    <style>
      :root {
        --card-bg: #fcfbf9;
        --border-color: #c4d6c7;
        --text-color: #2c352d;
        --text-muted: #556358;
        --accent: #1e3d24;
        --accent-hover: #122617;
        --hero-bg: #f5f0e6;
        --hero-border: #d8cebc;
        --gold-accent: #8c6d33;
        --gold-bg: #fbf6ec;
        --gold-border: #e6dcc5;
        --sage-accent: #4a6b52;
        --sage-bg: #edf3ee;
        --sage-border: #d3e2d5;
        --serif-font: "Georgia", "Times New Roman", serif;
      }
      body {
        font-family: system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
        background: linear-gradient(135deg, #d8e4da 0%, #eef3ef 50%, #d2e0d4 100%);
        color: var(--text-color);
        line-height: 1.6;
        min-height: 100vh;
      }
      header {
        background: rgba(252, 251, 249, 0.95);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border-color);
        padding: 20px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 1px 3px rgba(30, 61, 36, 0.05);
      }
      .brand-container {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
      }
      .brand-icon {
        width: 22px;
        height: 22px;
        object-fit: contain;
      }
      header h1 {
        margin: 0;
        font-family: var(--serif-font);
        font-size: 2rem;
        color: var(--accent);
        letter-spacing: -0.5px;
        font-weight: normal;
        font-style: italic;
      }
      nav a {
        color: var(--text-muted);
        text-decoration: none;
        margin-left: 20px;
        font-weight: 500;
        font-size: 0.95rem;
        transition: color 0.2s;
      }
      nav a:hover {
        color: var(--accent);
      }
      .layout {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 20px;
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 40px;
      }
      aside {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 24px;
        height: fit-content;
        box-shadow: 0 4px 12px rgba(30, 61, 36, 0.04);
      }
      aside h3 {
        margin-top: 0;
        font-family: var(--serif-font);
        font-size: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
        color: var(--accent);
        font-weight: normal;
        font-style: italic;
      }
      .filter-section {
        margin-bottom: 24px;
      }
      .filter-section:last-child {
        margin-bottom: 0;
      }
      .filter-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 8px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .filter-pills {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .filter-pill {
        background: #f5f2eb;
        border: 1px solid var(--border-color);
        color: var(--text-color);
        padding: 6px 10px;
        border-radius: 4px;
        font-size: 0.9rem;
        text-align: left;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
      }
      .filter-pill:hover {
        background: var(--sage-bg);
        border-color: var(--sage-accent);
        color: var(--sage-accent);
      }
      .filter-pill.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #fcfbf9;
        font-weight: 500;
      }
      
      /* Trope Cloud Styling */
      .trope-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
      }
      .trope-tag {
        background: #f5f2eb;
        border: 1px solid var(--border-color);
        color: var(--text-muted);
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: inherit;
        line-height: 1.2;
      }
      .trope-tag:hover {
        background: var(--sage-bg);
        border-color: var(--sage-accent);
        color: var(--sage-accent);
      }
      .trope-tag.active {
        background: var(--accent);
        border-color: var(--accent);
        color: #fcfbf9;
        font-weight: 600;
      }
      /* Font size weight classes for cloud effect */
      .trope-lg {
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--accent);
        background: #efece4;
      }
      .trope-md {
        font-size: 0.88rem;
      }
      .trope-sm {
        font-size: 0.78rem;
        opacity: 0.85;
      }

      .feed {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .welcome-banner {
        background: var(--hero-bg);
        border: 1px solid var(--hero-border);
        border-radius: 8px;
        padding: 36px 32px;
        box-shadow: 0 4px 16px rgba(30, 61, 36, 0.05);
        margin-bottom: 4px;
        text-align: center;
      }
      .hero-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
        margin-bottom: 12px;
        opacity: 0.85;
      }
      .welcome-banner h2 {
        margin-top: 0;
        font-family: var(--serif-font);
        color: var(--accent);
        font-size: 1.8rem;
        font-weight: normal;
        margin-bottom: 12px;
      }
      .welcome-banner p {
        margin: 0 auto;
        max-width: 620px;
        color: var(--text-muted);
        font-size: 1.05rem;
        line-height: 1.6;
      }
      .book-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 24px;
        box-shadow: 0 4px 12px rgba(30, 61, 36, 0.04);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        display: flex;
        gap: 20px;
      }
      .book-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(30, 61, 36, 0.08);
        border-color: var(--accent);
      }
      .book-card.hidden {
        display: none;
      }
      .cover-container {
        flex-shrink: 0;
        width: 110px;
        height: 165px;
        background: #e3ece4;
        border-radius: 4px;
        overflow: hidden;
        border: 1px solid var(--border-color);
      }
      .cover-container a {
        display: block;
        height: 100%;
      }
      .cover-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
      }
      .book-card:hover .cover-container img {
        transform: scale(1.03);
      }
      .book-info {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }
      .book-card h2 {
        margin-top: 0;
        margin-bottom: 6px;
        font-family: var(--serif-font);
        font-size: 1.5rem;
      }
      .title-link {
        color: #1a241c;
        text-decoration: none;
        transition: color 0.2s;
      }
      .title-link:hover {
        color: var(--accent);
        text-decoration: underline;
      }
      .meta {
        font-size: 0.95rem;
        color: var(--text-muted);
        margin-bottom: 10px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
      }
      .rating-badge {
        background: var(--gold-bg);
        color: var(--gold-accent);
        border: 1px solid var(--gold-border);
        padding: 3px 10px;
        border-radius: 4px;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 1px;
      }
      .vibe-teaser {
        font-family: var(--serif-font);
        font-style: italic;
        color: var(--sage-accent);
        background: var(--sage-bg);
        border: 1px solid var(--sage-border);
        padding: 6px 12px;
        border-radius: 4px;
        margin-top: 4px;
        font-size: 0.95rem;
        display: inline-block;
        border-left: 3px solid var(--sage-accent);
        width: fit-content;
      }
      .error {
        background: #fde8e8;
        color: #9b1c1c;
        padding: 15px;
        border-radius: 6px;
      }
      @media (max-width: 768px) {
        .layout {
          grid-template-columns: 1fr;
        }
        .book-card {
          flex-direction: column;
        }
        .cover-container {
          width: 120px;
          height: 180px;
          margin-bottom: 10px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="brand-container">
        <img src="/leaf-svgrepo-com.svg" alt="Leaf Icon" class="brand-icon" />
        <h1>Cherie Reads</h1>
      </a>
      <nav>
        <a href="/">Home</a>
        <a href="/guide">Guide</a>
        <a href="https://book-matchmaker.vercel.app/" target="_blank" rel="noopener noreferrer">Literary Apothecary 🌿</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <div class="layout">
      <!-- Charming Sidebar Filters with Trope Cloud -->
      <aside>
        <h3>Find Your Next Read</h3>
        
        <div class="filter-section">
          <span class="filter-label">Rating</span>
          <div class="filter-pills" id="rating-filter">
            <button class="filter-pill active" data-value="all">All Ratings</button>
            <button class="filter-pill" data-value="5">★★★★★ 5 Stars</button>
            <button class="filter-pill" data-value="4">★★★★☆ 4 Stars</button>
            <button class="filter-pill" data-value="3">★★★☆☆ 3 Stars</button>
            <button class="filter-pill" data-value="2">★★☆☆☆ 2 Stars</button>
            <button class="filter-pill" data-value="1">★☆☆☆☆ 1 Star</button>
          </div>
        </div>

        <div class="filter-section">
          <span class="filter-label">Genre</span>
          <div class="filter-pills" id="genre-filter">
            <button class="filter-pill active" data-value="all">All Genres</button>
            <button class="filter-pill" data-value="Fantasy">Fantasy</button>
            <button class="filter-pill" data-value="Sci-Fi">Sci-Fi</button>
            <button class="filter-pill" data-value="Romance">Romance</button>
            <button class="filter-pill" data-value="Historical">Historical</button>
            <button class="filter-pill" data-value="Mystery">Mystery</button>
          </div>
        </div>

        <div class="filter-section">
          <span class="filter-label">Tropes</span>
          <div class="trope-cloud" id="trope-filter">
            <button class="trope-tag active trope-lg" data-value="all">All Tropes</button>
            <button class="trope-tag trope-lg" data-value="Enemies to Lovers">Enemies to Lovers</button>
            <button class="trope-tag trope-lg" data-value="Found Family">Found Family</button>
            <button class="trope-tag trope-md" data-value="Chosen One">Chosen One</button>
            <button class="trope-tag trope-md" data-value="Slow Burn">Slow Burn</button>
            <button class="trope-tag trope-md" data-value="Forced Proximity">Forced Proximity</button>
            <button class="trope-tag trope-sm" data-value="Academia">Academia</button>
            <button class="trope-tag trope-sm" data-value="Retelling">Retelling</button>
            <button class="trope-tag trope-sm" data-value="Dual Timeline">Dual Timeline</button>
            <button class="trope-tag trope-sm" data-value="Grumpy/Sunshine">Grumpy/Sunshine</button>
            <button class="trope-tag trope-sm" data-value="Secret Identity">Secret Identity</button>
            <button class="trope-tag trope-sm" data-value="Quest">Quest</button>
          </div>
        </div>
      </aside>

      <!-- Main Review Feed -->
      <main class="feed">
        <!-- Elevated Hero Banner -->
        <div class="welcome-banner">
          <img src="/leaf-svgrepo-com.svg" alt="Leaf" class="hero-icon" />
          <h2>Welcome to My Reading Sanctuary</h2>
          <p>A quiet corner of the internet dedicated to sweeping fantasy, rich historical fiction, and stories that leave a lasting emotional mark. Grab a cup of tea and browse my digital bookshelf.</p>
        </div>

        {errorMessage && <div class="error"><p><strong>Error:</strong> {errorMessage}</p></div>}
        
        {booksWithContent.length === 0 && !errorMessage && (
          <p>No reviewed books found yet. Check the "Reviewed" box on a book page in your Notion library to publish it here!</p>
        )}

        {booksWithContent.map((book) => {
          const title = book.properties["Title"]?.title?.[0]?.plain_text || "Untitled";
          
          const authorArray = book.properties["Author name for Blog"]?.rollup?.array;
          let author = "Unknown Author";
          if (authorArray && authorArray.length > 0) {
            const names = authorArray.map((item) => item.title?.[0]?.plain_text).filter(Boolean);
            if (names.length > 0) author = names.join(", ");
          }

          const ratingProp = book.properties["Rating Number"] || book.properties["Star Rating"];
          let rating = "";
          if (ratingProp?.type === "number") rating = ratingProp.number.toString();
          else if (ratingProp?.type === "select") rating = ratingProp.select?.name || "";
          else if (ratingProp?.type === "formula") rating = ratingProp.formula.string || ratingProp.formula.number?.toString() || "";

          const vibeProp = book.properties["Vibe"] || book.properties["Genre"];
          let vibe = "";
          if (vibeProp?.type === "select") vibe = vibeProp.select?.name || "";
          else if (vibeProp?.type === "multi_select") vibe = vibeProp.multi_select?.map(v => v.name).join(', ') || "";
          else if (vibeProp?.type === "rich_text") vibe = vibeProp.rich_text?.[0]?.plain_text || "";

          const tropesList = book.properties["Tropes"]?.multi_select?.map(t => t.name).join(', ') || "";

          const mediaProp = book.properties["Cover"] || book.properties["Files & media"] || book.properties["Image"];
          let coverUrl = "";
          if (mediaProp?.type === "files" && mediaProp.files.length > 0) {
            const fileItem = mediaProp.files[0];
            coverUrl = fileItem.file?.url || fileItem.external?.url || "";
          }
          
          return (
            <div class="book-card" data-rating={rating} data-genre={vibe} data-tropes={tropesList}>
              {coverUrl && (
                <div class="cover-container">
                  <a href={`/books/${book.id}`}>
                    <img src={coverUrl} alt={`Cover of ${title}`} loading="lazy" />
                  </a>
                </div>
              )}
              <div class="book-info">
                <h2>
                  <a href={`/books/${book.id}`} class="title-link">{title}</a>
                </h2>
                <div class="meta">
                  <span><strong>Author:</strong> {author}</span>
                  {rating && <span class="rating-badge">{renderStars(rating)}</span>}
                </div>

                {vibe && <div class="vibe-teaser">{vibe}</div>}
              </div>
            </div>
          );
        })}
      </main>
    </div>

    <script>
      let currentRating = 'all';
      let currentGenre = 'all';
      let currentTrope = 'all';

      const ratingButtons = document.querySelectorAll('#rating-filter .filter-pill');
      const genreButtons = document.querySelectorAll('#genre-filter .filter-pill');
      const tropeTags = document.querySelectorAll('#trope-filter .trope-tag');
      const cards = document.querySelectorAll('.book-card');

      function filterCards() {
        cards.forEach(card => {
          const cardRating = card.getAttribute('data-rating') || '';
          const cardGenre = (card.getAttribute('data-genre') || '').toLowerCase();
          const cardTropes = (card.getAttribute('data-tropes') || '').toLowerCase();

          const matchesRating = (currentRating === 'all' || cardRating.includes(currentRating));
          const matchesGenre = (currentGenre === 'all' || cardGenre.includes(currentGenre.toLowerCase()));
          const matchesTrope = (currentTrope === 'all' || cardTropes.includes(currentTrope.toLowerCase()));

          if (matchesRating && matchesGenre && matchesTrope) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      }

      ratingButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          ratingButtons.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
          currentRating = e.target.getAttribute('data-value');
          filterCards();
        });
      });

      genreButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          genreButtons.forEach(btn => btn.classList.remove('active'));
          e.target.classList.add('active');
          currentGenre = e.target.getAttribute('data-value');
          filterCards();
        });
      });

      tropeTags.forEach(tag => {
        tag.addEventListener('click', (e) => {
          tropeTags.forEach(t => t.classList.remove('active'));
          e.target.classList.add('active');
          currentTrope = e.target.getAttribute('data-value');
          filterCards();
        });
      });
    </script>
  </body>
</html>
