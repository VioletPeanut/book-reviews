---
import { Client } from "@notionhq/client";

const notion = new Client({ auth: import.meta.env.NOTION_API_KEY });

let rawBooks = [];
let errorMessage = "";

try {
  const response = await notion.databases.query({
    database_id: import.meta.env.NOTION_DATABASE_ID,
    filter: {
      property: "Reviewed",
      checkbox: { equals: true }
    }
  });
  rawBooks = response.results;
} catch (error) {
  errorMessage = error.message;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Author Debugger</title>
    <style>
      body { font-family: monospace; max-width: 900px; margin: 30px auto; padding: 20px; background: #222; color: #eee; }
      .card { background: #333; padding: 15px; margin-bottom: 15px; border-radius: 5px; }
      pre { background: #111; padding: 10px; overflow-x: auto; color: #0ff; }
    </style>
  </head>
  <body>
    <h1>Notion Author Property Debugger</h1>
    {errorMessage && <p style="color: red;">Error: {errorMessage}</p>}
    
    {rawBooks.map((book) => {
      const title = book.properties["Title"]?.title?.[0]?.plain_text || "Untitled";
      const authorProp = book.properties["Author name for Blog"] || book.properties["Author"];
      
      return (
        <div class="card">
          <h3>Book: {title}</h3>
          <p><strong>Raw Property JSON:</strong></p>
          <pre>{JSON.stringify(authorProp, null, 2)}</pre>
        </div>
      );
    })}
  </body>
</html>
